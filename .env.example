#  do: cp .env.example .env
# (create a .env and copy this content to there, and fill the key)

# Required. Anthropic API key for baseline, workflow agents, and judge.
# The SDK (new Anthropic() in src/client.ts) reads this from the environment.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant